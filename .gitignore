# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments and tooling caches
.venv
.pytest_cache

# Marimo notebook session state
**/__marimo__/
**/persist.json

# LibreOffice lock files
.~lock.*#

# Heavy experiment data: raw EVT3 recordings, exported videos, CAD workspace.
# See data/README.md for provenance and naming conventions; only the README
# itself is tracked.
data/**
!data/README.md

# Analysis outputs are delivered through the data image, not git; only the
# self-describing README is tracked. Superseded runs (results/archive/) are
# excluded from the image as well.
results/**
!results/README.md

# Local tool settings
.claude/settings.local.json
